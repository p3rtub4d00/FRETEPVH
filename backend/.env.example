PORT=3001
MONGODB_URI=
# Primeira conta Master. Defina valores particulares no Render.
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador FreteOn
# Google Maps Platform: habilite Places API (New), Routes API e Geocoding API.
# Configure esta chave somente no backend / Render. Não envie ao frontend.
GOOGLE_MAPS_API_KEY=


# Mercado Pago - Pix do cliente e comissão do motorista.
# Deixe DESLIGADO até cadastrar credenciais e validar webhook/teste completo.
MP_PAYMENTS_ENABLED=false
# Token privado da conta Mercado Pago do FreteOn, somente no backend / Render.
MP_ACCESS_TOKEN=
# Assinatura secreta cadastrada em Mercado Pago > Webhooks (evento payment).
MP_WEBHOOK_SECRET=
# URL HTTPS pública do serviço, sem barra no final (ex.: https://seu-servico.onrender.com).
MP_PUBLIC_URL=


# PagBank - Pix de frete e comissão. Desabilitado até homologação.
PAGBANK_ENABLED=false
# sandbox ou production; use sandbox nos testes.
PAGBANK_ENV=sandbox
# Token privado do ambiente selecionado. Nunca enviar para o frontend.
PAGBANK_TOKEN=
# Opcional para webhooks ECDSA x-payload-signature da nova API de Notificações.\n# Webhooks Order com x-authenticity-token usam PAGBANK_TOKEN; ambos são validados.
PAGBANK_WEBHOOK_PUBLIC_KEY=
# Domínio HTTPS do FreteOn, sem barra no fim.
PAGBANK_PUBLIC_URL=
# Exige decisão explícita antes de liberar operações de produção.
PAGBANK_PRODUCTION_ALLOWED=false
